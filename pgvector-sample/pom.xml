<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.nephets</groupId>
    <artifactId>pgvector-kit</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>pgvector-sample</artifactId>
  <name>pgvector-sample</name>
  <description>可运行 demo：库存业务表 + 向量表写进同一个事务，一条 SQL 查出相似商品</description>

  <dependencies>
    <dependency>
      <groupId>io.github.nephets</groupId>
      <artifactId>pgvector-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        ★ sample 是 demo 目录，覆盖率门禁刻意不开：
        它的主要逻辑（PgVectorHybridQueryIT）依赖 Docker，本机没有 Docker 时会被合理跳过，
        此时任何百分比阈值都会变成一个「因为没跑测试而失败」的假红。
        真实查询正确性由 CI（有 Docker）上的 compose-smoke job 跑同一份 IT 来保证。
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <id>integration-test</id>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <properties>
    <jacoco.skip>true</jacoco.skip>
  </properties>
</project>
