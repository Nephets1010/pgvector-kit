<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    父 POM：Spring Boot 3.5.16 + Java 21
    - Boot 3.5.16 是 3.5 线最后一个 OSS 补丁版本（3.5 线 OSS 支持已于 2026-06-30 结束）
    - 本项目刻意只依赖 Boot 的 JDBC/自动装配，不引入 Spring AI（不做 embedding，见 README「不做什么」）
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>io.github.nephets</groupId>
  <artifactId>pgvector-kit</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>pgvector-kit</name>
  <description>pgvector-kit：让业务表和向量表写进同一条 SQL、同一个事务的 Spring Boot + pgvector 数据层组件</description>
  <url>https://github.com/Nephets1010/pgvector-kit</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>nephets</id>
      <name>pgvector-kit maintainers</name>
      <url>https://github.com/Nephets1010</url>
    </developer>
  </developers>

  <scm>
    <url>https://github.com/Nephets1010/pgvector-kit</url>
    <connection>scm:git:https://github.com/Nephets1010/pgvector-kit.git</connection>
  </scm>

  <modules>
    <module>pgvector-core</module>
    <module>pgvector-mybatis</module>
    <module>pgvector-jpa</module>
    <module>pgvector-spring-boot-starter</module>
    <module>pgvector-sample</module>
  </modules>

  <properties>
    <!--
      ★ 预先定义一个空的 argLine 属性。
      surefire / failsafe 用 @{argLine} 引用它，jacoco:prepare-agent 在运行期把 -javaagent:... 注入进来。
      若不预先定义，@{argLine} 会保持字面量不被解析，导致 jacoco 找不到执行数据 ——
      覆盖率报告为空，而 check 规则会因「无数据」静默通过。那比没有门禁更危险。
    -->
    <argLine></argLine>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- ==== 锁版本：禁止用浮动版本号 ==== -->
    <mybatis.version>3.5.19</mybatis.version>
    <postgresql.version>42.7.11</postgresql.version>
    <jakarta-persistence.version>3.1.0</jakarta-persistence.version>
    <testcontainers.version>1.21.3</testcontainers.version>
    <h2.version>2.3.232</h2.version>
    <assertj.version>3.27.3</assertj.version>

    <spotless.version>2.44.4</spotless.version>
    <google-java-format.version>1.25.2</google-java-format.version>
    <jacoco.version>0.8.13</jacoco.version>

    <!-- ==== 覆盖率门禁 ==== -->
    <jacoco.skip>false</jacoco.skip>
    <jacoco.line.minimum>0.70</jacoco.line.minimum>
    <!--
      ★★ jacoco 执行数据用【相对路径】：
      Windows 上 -javaagent 的 destfile 参数一旦含非 ASCII 字符，就会被截断在第一个非 ASCII 处
      （本项目实测 D:\data\WorkBuddy\程序宇宙\… 被截成 D:\data\WorkBuddy\），
      随后 jacoco 静默丢失执行数据，report/check 因「无数据」而假通过 ——
      一个会骗过 CI 的门禁比没有门禁更危险。
      相对路径不会出现非 ASCII 字符，且由 JVM 按工作目录解析；
      surefire/failsafe 的 workingDirectory 已钉死为 ${project.basedir}，所以它就是 <模块>/target/jacoco.exec。
    -->
    <jacoco.dest.file>target/jacoco.exec</jacoco.dest.file>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- 本仓模块 -->
      <dependency>
        <groupId>io.github.nephets</groupId>
        <artifactId>pgvector-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.nephets</groupId>
        <artifactId>pgvector-mybatis</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.nephets</groupId>
        <artifactId>pgvector-jpa</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.nephets</groupId>
        <artifactId>pgvector-spring-boot-starter</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- 三方 -->
      <dependency>
        <groupId>org.mybatis</groupId>
        <artifactId>mybatis</artifactId>
        <version>${mybatis.version}</version>
      </dependency>
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>${postgresql.version}</version>
      </dependency>
      <dependency>
        <groupId>jakarta.persistence</groupId>
        <artifactId>jakarta.persistence-api</artifactId>
        <version>${jakarta-persistence.version}</version>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!--
    ★ 刻意不在父 POM 的 <dependencies> 里声明通用依赖。
      若在此声明 spring-boot-starter-test，那么每个子模块都会背上它的传递依赖，
      「pgvector-core 零第三方依赖」这条边界就无法用机器判定。各子模块按需显式声明。
  -->

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <release>${maven.compiler.release}</release>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <includes>
              <include>**/*Test.java</include>
            </includes>
            <excludes>
              <exclude>**/*IT.java</exclude>
            </excludes>
            <!-- @{argLine} 占位符保证 jacoco 注入的 agent 参数不会被覆盖 -->
            <argLine>@{argLine} -Xmx512m -Xms64m -XX:+ExitOnOutOfMemoryError</argLine>
            <!--
              ★ 显式指定 fork 的工作目录：jacoco agent 的相对 destFile 正是按它解析的。
              不指定时不同 Maven/surefire 版本解析基准不同，会导致执行数据找不到、门禁静默失效。
            -->
            <workingDirectory>${project.basedir}</workingDirectory>
            <forkCount>1</forkCount>
            <reuseForks>true</reuseForks>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <configuration>
            <includes>
              <include>**/*IT.java</include>
            </includes>
            <argLine>@{argLine} -Xmx512m</argLine>
            <workingDirectory>${project.basedir}</workingDirectory>
            <forkCount>1</forkCount>
            <reuseForks>true</reuseForks>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
        </plugin>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!--
        ==== 每次构建先清空本模块的 jacoco .exec ====
        jacoco 的 append=false 只覆盖单元测试那一份；集成测试是 append=true。
        若不先删，上一次 verify 的数据会混进这一次的 report/check，
        覆盖率反映的是「历史」而不是「当前代码」。本项目实测踩过这类假数据。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>clean-stale-jacoco-data</id>
            <!-- 必须早于 prepare-agent，否则本轮 agent 写出的数据会被自己删掉 -->
            <phase>initialize</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <delete file="${jacoco.dest.file}" failonerror="false" quiet="true"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- ==== 强制 Java 21 与 Maven 版本 ==== -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-environment</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,22)</version>
                  <message>本项目需要 JDK 21（record pattern 与 switch pattern）。当前 JAVA_HOME=$(java.home)</message>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9.9,)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        ==== 统一代码格式 ====
        ★ 绑的是 check 而不是 apply：apply 会在构建里悄悄改代码然后「通过」，
          那等于把门禁变成了自动美化器，CI 上永远不会红，也就永远不会阻止糟糕的提交。
      -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>spotless-check</id>
            <phase>validate</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <java>
            <includes>
              <include>src/main/java/**/*.java</include>
              <include>src/test/java/**/*.java</include>
            </includes>
            <licenseHeader>
              <file>${maven.multiModuleProjectDirectory}/LICENSE-HEADER.txt</file>
            </licenseHeader>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
              <style>AOSP</style>
            </googleJavaFormat>
            <removeUnusedImports/>
            <importOrder>
              <order>com,io,org,javax,java,\#</order>
            </importOrder>
          </java>
          <formats>
            <format>
              <includes>
                <include>*.md</include>
                <include>docs/**/*.md</include>
              </includes>
              <trimTrailingWhitespace/>
              <endWithNewline/>
            </format>
          </formats>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
            <configuration>
              <destFile>${jacoco.dest.file}</destFile>
              <append>false</append>
            </configuration>
          </execution>
          <!--
            ★ 集成测试的数据「追加」到与单元测试相同的文件，而不是另存 -it.exec 再 merge。
            理由：jacoco:merge 的 fileSet 语义在「某些文件不存在」时会直接报 fileSets 缺失
            （多数模块都没有 *IT.java），踩过一次就够了。
          -->
          <execution>
            <id>prepare-agent-integration</id>
            <goals>
              <goal>prepare-agent-integration</goal>
            </goals>
            <configuration>
              <destFile>${jacoco.dest.file}</destFile>
              <append>true</append>
            </configuration>
          </execution>
          <execution>
            <id>coverage-report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
            <configuration>
              <dataFile>${jacoco.dest.file}</dataFile>
              <formats>
                <format>HTML</format>
                <format>XML</format>
                <format>CSV</format>
              </formats>
            </configuration>
          </execution>
          <execution>
            <id>coverage-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <haltOnFailure>true</haltOnFailure>
              <dataFile>${jacoco.dest.file}</dataFile>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.line.minimum}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- 跨模块覆盖率汇总：mvn -Pcoverage verify 后看 target/site/jacoco-aggregate/index.html -->
    <profile>
      <id>coverage</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>aggregate-report</id>
                <phase>verify</phase>
                <goals>
                  <goal>report-aggregate</goal>
                </goals>
                <configuration>
                  <outputDirectory>${project.build.directory}/site/jacoco-aggregate</outputDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
