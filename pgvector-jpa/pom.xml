<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.nephets</groupId>
    <artifactId>pgvector-kit</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>pgvector-jpa</artifactId>
  <name>pgvector-jpa</name>
  <description>JPA 的 vector AttributeConverter：实体里直接写 float[] 字段</description>

  <dependencies>
    <dependency>
      <groupId>io.github.nephets</groupId>
      <artifactId>pgvector-core</artifactId>
    </dependency>

    <!-- SLF4J API（compile 作用域，版本由 Spring Boot parent 管理）：为 VectorConverter 提供可观测日志 -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <!-- provided：JPA 容器（Hibernate）必然已由使用方引入 -->
    <dependency>
      <groupId>jakarta.persistence</groupId>
      <artifactId>jakarta.persistence-api</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <properties>
    <jacoco.line.minimum>0.80</jacoco.line.minimum>
  </properties>
</project>
